  m_Script: {fileID: 11500000, guid: 6a88b22bc2ab974469ac44a1525515ca, type: 3}
  m_Name: Cassandra - Entry 2
  m_EditorClassIdentifier: 
  storyText: "PATIENT: Cassandra Bouchat\nDATE: June 3/1981\n\nIt seems that Cassandra's
    symptoms are getting worse. Today, she described an episode where she secretly
    drove to her husband's office. She hid in a distant parking lot and waited to
    to watch him leave. She does not seem to be internalizing the coping strategies
    we have discussed. Perhaps it's time to try another solution. I wrote her a prescription
    for Sertreline.\n\t\t>>1. BACK"
  nextStates:
  - {fileID: 11400000, guid: 4cbbb4a98db14f648b39e216ab0f3eff, type: 2}
